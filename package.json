{
  "name": "nom-cloud",
  "description": "Private, multilingual school management platform — marketing site plus an Admin/Teacher/Parent product prototype. React + TypeScript + Vite + Tailwind CSS.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "tsc --noEmit",
    "test:operator-workspace": "node --experimental-strip-types --test --test-concurrency=1 tests/operator-workspace.browser.test.mjs tests/operator-workspace-migrations.test.mjs tests/school-application-contract.test.mjs tests/school-application-email.test.mjs tests/platform-provider-contracts.test.mjs tests/payment-provider-contract.test.mjs tests/payment-flow-contract.test.mjs tests/approval-feature-flag-contract.test.mjs tests/operator-workspace-mock-data.test.mjs tests/platform-edge-function-contracts.test.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/supabase-js": "^2.112.4",
    "exceljs": "^4.4.0",
    "papaparse": "^5.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2",
    "thinking-orbs": "^0.3.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@types/node": "^20.14.15",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "playwright": "^1.64.1",
    "postcss": "^8.4.41",
    "supabase": "^2.116.0",
    "tailwindcss": "^3.4.10",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  }
}
